# ── Required ────────────────────────────────────────────────────────────
# Railway: add a PostgreSQL service and set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5432/affordable_life

# Long random string (e.g. `openssl rand -hex 32`). Never change it after launch,
# or existing sessions and password-reset tokens become invalid.
PAYLOAD_SECRET=replace-with-a-long-random-string

# First CMS admin, created automatically on first boot when no admin exists.
# Change the password in /admin after logging in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Recommended on Railway ──────────────────────────────────────────────
# Mount a Railway volume at /data so uploads survive redeploys.
UPLOADS_DIR=/data/uploads

# Public URL. Optional on Railway (derived from RAILWAY_PUBLIC_DOMAIN);
# set it when you attach a custom domain, e.g. https://affordablelife.co.za
# SITE_URL=https://affordablelife.co.za

# ── Optional ────────────────────────────────────────────────────────────
# Seed the launch suburbs and six verified demo homes into an empty database.
# SEED_DEMO_DATA=false
# Force TLS for the database connection (auto-detected for Railway's public proxy).
# DATABASE_SSL=true
