{
  "name": "affordable-life",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port ${PORT:-3000}",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" payload build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port ${PORT:-3000} --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.8",
    "@payloadcms/email-nodemailer": "4.0.0-beta.8",
    "@payloadcms/next": "4.0.0-beta.8",
    "@payloadcms/richtext-lexical": "4.0.0-beta.8",
    "@payloadcms/transformer-sharp": "4.0.0-beta.8",
    "@payloadcms/translations": "4.0.0-beta.8",
    "@payloadcms/ui": "4.0.0-beta.8",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "^1.74.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.6",
    "payload": "4.0.0-beta.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": "3.4.18"
    }
  }
}
